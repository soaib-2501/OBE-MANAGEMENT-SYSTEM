# Required. Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-string

# true locally, false in production
DEBUG=true

# Postgres (Neon). sslmode=require is needed for Neon / Render.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production examples:
# ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app,https://your-backend.onrender.com
